# Puerto HTTP en el que se sirve la web app (móviles abren http://IP-del-servidor:PORT)
PORT=3000
# IP de la TV (también puede configurarse desde la propia app)
TV_IP=192.168.1.50
TV_PORT=55000
# MAC de la TV (solo para Wake-on-LAN; opcional)
TV_MAC=
# Nombre que verá la TV en el aviso "¿Permitir?"
REMOTE_NAME=Mando Web
# PIN opcional para que solo quien lo conozca pueda usar el mando (vacío = sin PIN)
ACCESS_PIN=
# Carpeta donde guardar configuración y archivos multimedia subidos
DATA_DIR=./data
